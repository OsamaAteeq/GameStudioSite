@{
    ViewData["Title"] = "About";
    ViewData["HeroText"] = "Who Are We?";
    ViewData["HeroImage"] = "~/images/header-about.jpg";
    ViewData["Description"] = "JZB4 Studios is a group of game developers and designers growing a community where developers and players make games together.";
}
<div class="dark-background">
    <p>JZB4 Studios is a group of game developers and designers united by a passion for making games. We've learned and built together, and every game on this site comes from that shared journey.</p>
    <p>What began as a home for our own games is growing into something bigger: a community where developers and players come together, ideas find the right people, and everyone who contributes is valued and fairly rewarded. When a project calls for a skill beyond our team, we welcome the right person in to help bring it to life.</p>
</div>
<div class="dark-background">
    <div class="horizontal-content image-first-mobile bright-contain">
        <img src="~/images/Mission11.jpg" alt="Mission"/>
        <div class="vertical-content">
            <p class="center-text"> Our mission is to turn ideas into meaningful experiences through creativity, collaboration, and a shared passion for interactive entertainment. We bring together talented people to develop our own games and help others realize their projects, matching skills with opportunities and making the most of every collaboration. By staying connected with developers and players alike, we strive to create lasting value for everyone involved.</p>
        </div>
    </div>
</div>
<div class="dark-background">
    <div class="horizontal-content image-first-mobile bright-contain">
        <div class="vertical-content">
            <p class="center-text"> Our vision is to build a thriving network where developers, creators, businesses, and players can come together to make great things happen. We aspire to create opportunities for talent to grow, help ambitious ideas become reality, and develop games shaped by the people who play them. Through collaboration, trust, and a shared passion for play, we aim to build an organization where everyone can contribute to something meaningful.</p>
        </div>
        <img src="~/images/Vision11.jpg" alt="Vision"/>
    </div>
</div>

<div class="gradient-black-actual-black">
</div>