@model List<GameStudioSite.Models.Game>
@{
    ViewData["Title"] = "Manage Games";
}

<div class="admin-page-header">
    <h1>Games</h1>
    <a class="btn" asp-action="Create">+ Add Game</a>
</div>

@if (TempData["AdminMessage"] != null)
{
    <div class="admin-flash-message">@TempData["AdminMessage"]</div>
}

<table class="admin-table">
    <thead>
        <tr>
            <th>Image</th>
            <th>Title</th>
            <th>Slug</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var game in Model)
        {
            <tr style="justify-content:center">
                <td><img src="@game.ImageUrl" alt="@game.Title" class="admin-thumb" /></td>
                <td>@game.Title</td>
                <td>@game.Slug</td>
                <td style="border-left: solid;">
                    <div class ="admin-row-actions">
                        <a asp-action="Edit" asp-route-id="@game.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@game.Id" method="post" class="admin-delete-form"
                            onsubmit="return confirm('Delete this game?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="admin-link-button">Delete</button>
                        </form>
                        <a href="@game.ImageUrl" download title="Download Image" aria-label="Download Image">
                        <i class="fa-solid fa-download"></i>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>