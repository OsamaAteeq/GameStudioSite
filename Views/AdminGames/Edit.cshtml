@model GameStudioSite.Models.AdminGameFormModel
@{
    ViewData["Title"] = "Edit Game";
}

<h1>Edit Game</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="admin-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ExistingImageUrl" />
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div class="form-group">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Slug"></label>
        <input asp-for="Slug" class="form-control" />
        <span asp-validation-for="Slug" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="ItchIoUrl"></label>
        <input asp-for="ItchIoUrl" class="form-control" />
        <span asp-validation-for="ItchIoUrl" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label>Current Image</label><br />
        <img src="@Model.ExistingImageUrl" alt="Current image" class="admin-thumb-large" />
    </div>

    <div class="form-group">
        <label asp-for="ImageFile">Replace Image (optional)</label>
        <input asp-for="ImageFile" type="file" accept="image/*" class="form-control" />
        <span asp-validation-for="ImageFile" class="field-validation-error"></span>
    </div>

    <button type="submit" class="btn">Save</button>
</form>