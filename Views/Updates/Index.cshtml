@model GameStudioSite.Models.BlogIndexViewModel
@{
    ViewData["Title"] = "Updates";
    ViewData["HeroText"] = "Updates";
    ViewData["HeroImage"] = "~/images/header-blog.jpg";
    ViewData["Gradient"] = "gradient-trans-blue";
    ViewData["Description"] = "Read the latest updates from JZB4 Studios: game releases, development news, and more.";
}
<div class="light-background" id="updates-content">
<div class="filter-bar">
    <a asp-action="Index" asp-fragment="updates-content" class="@(Model.SelectedCategory == null ? "active" : "")">All</a>
    @foreach (var cat in Model.Categories)
    {
        <a asp-action="Index" asp-route-category="@cat" asp-fragment="updates-content" 
           class="@(Model.SelectedCategory == cat ? "active" : "")">@cat</a>
    }
</div>
    @if (Model.Posts.Count == 0)
    {
        <div class="vertical-content">
            <h1>Sorry</h1>
            <h3>We have no updates now</h3>
            <h3>Come back later!</h3>
        </div>
    }
    <div class="update-list-grid">
    @foreach (var update in Model.Posts)
    {
            <a class="update-list-card" href="@update.Url">
                <div class="update-list-card-image">
                    <img src="@update.FeaturedImageUrl"
                         srcset="@Images.GetSrcSet(update.FeaturedImageUrl)"
                         sizes="(max-width: 992px) 94vw, 29vw"
                         alt="@update.ImageAltText" loading="lazy" />
                </div>
                <div class="update-list-card-content">
                    <h4>
                        @update.Title
                    </h4>
                    <div class="update-list-card-info">
                        <p class="left">
                        @foreach (var tag in update.Tags)
                        {
                            <span>@tag</span>
                        }
                        </p>
                        <div class="right">
                        @if (string.IsNullOrEmpty(Model.SelectedCategory))
                        {
                            <span class="post-category">@update.Category</span>
                        }
                            <span>@update.PublishedDate.ToString("M"), @update.PublishedDate.ToString("yyyy")</span>
                        
                        </div>

                    </div>
                    <p>
                        @update.Excerpt
                    </p>
                </div>

            </a>
    }
</div>

    @{
        Func<int, string> pageUrl = p => Url.Action("Index", "Updates",
        new { page = p, category = Model.SelectedCategory },
        protocol: null, host: null, fragment: "updates-content")!;
    }
    <partial name="_Pagination"
             model="new GameStudioSite.Models.PaginationModel { CurrentPage = Model.CurrentPage, TotalPages = Model.TotalPages, PageUrl = pageUrl }" />

</div>
<div class="gradient-blue-actual-black"></div>
