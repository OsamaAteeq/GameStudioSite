@model GameStudioSite.Models.AdminBlogIndexViewModel
@{
    ViewData["Title"] = "Manage Updates";
}

<div class="admin-page-header">
    <h1>Updates</h1>
    <a class="btn" asp-action="Create">+ Add Update</a>
</div>

@if (TempData["AdminMessage"] != null)
{
    <div class="admin-flash-message">@TempData["AdminMessage"]</div>
}

<div class="admin-categories-box">
    <h3>Categories</h3>
    <div class="category-chip-list">
        @foreach (var category in Model.Categories)
        {
            <span class="category-chip @(category.IsPublic ? "" : "category-chip-private")">
                @category.Name
                @if (!category.IsPublic)
                {
                    <span class="chip-private-label">(hidden)</span>
                }
                <form asp-action="DeleteCategory" asp-route-id="@category.Id" method="post"
                      class="admin-delete-form" onsubmit="return confirm('Delete this category?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="category-chip-delete" title="Delete">&times;</button>
                </form>
            </span>
        }
    </div>

    <form asp-action="CreateCategory" method="post" class="category-add-form">
        @Html.AntiForgeryToken()
        <input type="text" name="name" placeholder="New category name" class="form-control" required />
        <label class="checkbox-label-inline">
            <input type="checkbox" name="isPublic" value="true" checked />
            Public
        </label>
        <button type="submit" class="btn btn-small">Add</button>
    </form>
</div>
<div class="admin-sort-bar">
    @if (Model.OldestFirst)
    {
        <a class="btn btn-small" asp-action="Index">Showing: Oldest first &middot; Switch to newest first</a>
    }
    else
    {
        <a class="btn btn-small" asp-action="Index" asp-route-sort="oldest">Showing: Newest first &middot; Switch to oldest first</a>
    }
</div>
<div class="btn-group btn-group-sm ms-3" role="group" aria-label="Filter posts by visibility" id="visibilityFilter" style="margin-bottom:1rem;">
    <button type="button" class="btn btn-outline-secondary active" data-filter="all">All</button>
    <button type="button" class="btn btn-outline-secondary" data-filter="public">Public</button>
    <button type="button" class="btn btn-outline-secondary" data-filter="hidden">Hidden</button>
</div>
<table class="admin-table">
    <colgroup>
        <col style="width: auto;" />
        <col style="width: auto;" />
        <col style="width: auto;" />
        <col style="width: auto;" />
        <col style="width: auto;" />
        <col style="width: 20%;" />
    </colgroup>
    <thead>
        <tr>
            <th>Image</th>
            <th>Title</th>
            <th>Category</th>
            <th>Published</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var post in Model.Posts)
        {
            <tr data-post-row data-hidden-category="@(Model.PrivateCategoryNames.Contains(post.Category) ? "true" : "false")" style="justify-content:center">
                <td><img src="@post.FeaturedImageUrl" alt="@post.ImageAltText" class="admin-thumb" /></td>
                <td>@post.Title</td>
                <td>@post.Category</td>
                <td>@post.PublishedDate.ToString("MMM d, yyyy")</td>
                <td>
                    @if (Model.PrivateCategoryNames.Contains(post.Category))
                    {
                        <span class="status-badge status-private">Hidden</span>
                    }
                    else
                    {
                        <span class="status-badge status-public">Public</span>
                    }
                </td>
                <td style="border: none; border-left: solid;">
                    <div class="admin-row-actions">
                        <a asp-action="Edit" asp-route-id="@post.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@post.Id" asp-route-sort="@(Model.OldestFirst ? "oldest" : null)" class="admin-delete-form"
                            method="post" class="admin-inline-form"
                            onsubmit="return confirm('Delete this update?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="admin-link-button">Delete</button>
                        </form>
                        <button type="button" class="btn btn-sm btn-outline-secondary" style="padding:0.6rem;"
                                data-copy-path="@post.Url" title="Copy link" aria-label="Copy link">
                            <i class="fa-regular fa-copy"></i>
                        </button>
                        <a href="@post.FeaturedImageUrl" download title="Download Image" aria-label="Download Image">
                            <i class="fa-solid fa-download"></i>
                        </a>
                    </div>
                </td>
                
            </tr>
        }
    </tbody>
</table>

<script>
    document.addEventListener('click', async (e) => {
        const btn = e.target.closest('[data-copy-path]');
        if (!btn) return;
        const link = location.origin + btn.dataset.copyPath;
        const icon = btn.querySelector('i');
        try {
            await navigator.clipboard.writeText(link);
            icon.className = 'fa-solid fa-check';
            btn.title = 'Copied!';
        } catch {
            prompt('Copy this link:', link);
        }
        setTimeout(() => {
            icon.className = 'fa-regular fa-copy';
            btn.title = 'Copy link';
        }, 1500);
    });

    (function () {
        const group = document.getElementById('visibilityFilter');
        if (!group) return;
        const buttons = group.querySelectorAll('[data-filter]');
        const KEY = 'admin.postVisibilityFilter';

        function apply(filter) {
            document.querySelectorAll('[data-post-row]').forEach(row => {
                const hidden = row.dataset.hiddenCategory === 'true';
                const show = filter === 'all'
                    || (filter === 'public' && !hidden)
                    || (filter === 'hidden' && hidden);
                row.style.display = show ? '' : 'none';
            });
            buttons.forEach(b => b.classList.toggle('active', b.dataset.filter === filter));
        }

        let current = 'all';
        try {
            const saved = localStorage.getItem(KEY);
            if (['all', 'public', 'hidden'].includes(saved)) current = saved;
        } catch { }

        buttons.forEach(b => b.addEventListener('click', () => {
            current = b.dataset.filter;
            try { localStorage.setItem(KEY, current); } catch { }
            apply(current);
        }));

        apply(current);
    })();
</script>