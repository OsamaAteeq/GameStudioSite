@model GameStudioSite.Models.AdminBlogPostPageViewModel
@{
    ViewData["Title"] = "Edit Update";
}

<h1>Edit Update</h1>

<form asp-action="Edit" asp-route-id="@Model.Form.Id" method="post" enctype="multipart/form-data" class="admin-form" id="update-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Form.Id" />
    <input type="hidden" asp-for="Form.ExistingImageUrl" />
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div class="form-group">
        <label asp-for="Form.Title"></label>
        <input asp-for="Form.Title" class="form-control" />
        <span asp-validation-for="Form.Title" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Form.Slug"></label>
        <input asp-for="Form.Slug" class="form-control" />
        <span asp-validation-for="Form.Slug" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Form.Excerpt"></label>
        <textarea asp-for="Form.Excerpt" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Form.Excerpt" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label>Content</label>
        <div class="quill-decorator">
        <div id="quill-editor" class="quill-container"></div>
        <input type="hidden" asp-for="Form.ContentHtml" id="content-html-input" />
        <span asp-validation-for="Form.ContentHtml" class="field-validation-error"></span>
    </div>
    </div>

    <div class="form-group">
        <label>Category</label>
        <select name="Form.Category" class="form-control" required>
            <option value="">-- Select a category --</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Name" selected="@(category.Name == Model.Form.Category)">@category.Name</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label asp-for="Form.TagsInput">Tags (comma-separated)</label>
        <input asp-for="Form.TagsInput" class="form-control" placeholder="Unity, Mazda, Automotive" />
    </div>

    <div class="form-group">
        <label asp-for="Form.PublishedDate"></label>
        <input asp-for="Form.PublishedDate" class="form-control" />
        <span asp-validation-for="Form.PublishedDate" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label>Current Image</label><br />
        <img src="@Model.Form.ExistingImageUrl" alt="Current image" class="admin-thumb-large" />
    </div>

    <div class="form-group">
        <label asp-for="Form.ImageFile">Replace Featured Image (optional)</label>
        <input asp-for="Form.ImageFile" type="file" accept="image/*" class="form-control" />
        <span asp-validation-for="Form.ImageFile" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label class="checkbox-label">
            <input type="checkbox" asp-for="Form.ShowImage" />
            Show the featured image on the update page
        </label>
    </div>

    <div class="form-group">
        <label asp-for="Form.ImageAltText"></label>
        <input asp-for="Form.ImageAltText" class="form-control" />
    </div>

    <button type="submit" class="btn">Save</button>
</form>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
    <script>
                const icons = Quill.import('ui/icons');
        icons['embed'] = '<svg viewBox="0 0 18 18"><rect class="ql-stroke" height="10" width="12" x="3" y="4"></rect><circle class="ql-fill" cx="9" cy="9" r="2"></circle></svg>';

            const quill = new Quill('#quill-editor', {
            theme: 'snow',
            modules: {
                toolbar: {
                    container: [
                        [{ header: [1, 2, 3, false] }],
                        ['bold', 'italic', 'underline', 'link'],
                        [{ list: 'ordered' }, { list: 'bullet' }],
                        [{ align: [] }],
                        ['image', 'embed'],
                        ['clean']
                    ],
                    handlers: {
                        image: insertImageByUrl,
                        embed: insertEmbedCode
                    }
                }
            }
        });

        function insertImageByUrl() {
            const url = prompt('Paste the image URL:');
            if (!url) return;

            const range = quill.getSelection(true);
            quill.insertEmbed(range.index, 'image', url, 'user');
            quill.setSelection(range.index + 1);
        }

        // Accepts either a plain video URL (YouTube/Vimeo/direct file) or a raw embed
        // snippet copied from somewhere like itch.io's "Embed this game" page.
        function insertEmbedCode() {
            const input = prompt(
                'Paste a video URL, or an embed code (e.g. from itch.io\'s "Embed this game" page):'
            );
            if (!input) return;

            const trimmed = input.trim();
            let html;

            if (trimmed.startsWith('<iframe') || trimmed.includes('<iframe')) {
                // Raw embed snippet, pasted exactly as the platform gave it — itch.io, Twitch,
                // CodePen, Vimeo, anything. Keep its own size/styling untouched.
                html = trimmed;
            } else if (/\.(mp4|webm|ogg)$/i.test(trimmed)) {
                // A direct link to a video file
                html = `<video class="embed-responsive" src="${trimmed}" controls></video>`;
            } else {
                const embedUrl = toKnownEmbedUrl(trimmed);
                if (!embedUrl) {
                    alert('Could not recognize that as a video URL or an embed code.');
                    return;
                }
                html = `<iframe class="embed-responsive" src="${embedUrl}" allowfullscreen></iframe>`;
            }

            const range = quill.getSelection(true);
            // dangerouslyPasteHTML bypasses Quill's normal typing-sanitization, which is what lets
            // us insert a real <iframe>/<video> tag. Safe here since only you, logged into the
            // admin panel, can reach this — never expose this kind of insertion to public input.
            quill.clipboard.dangerouslyPasteHTML(range.index, html, 'user');
        }

        function toKnownEmbedUrl(url) {
            const patterns = [
                { regex: /youtube\.com\/watch\?v=([a-zA-Z0-9_-]{11})/, embed: id => `https://www.youtube.com/embed/${id}` },
                { regex: /youtu\.be\/([a-zA-Z0-9_-]{11})/, embed: id => `https://www.youtube.com/embed/${id}` },
                { regex: /vimeo\.com\/(\d+)/, embed: id => `https://player.vimeo.com/video/${id}` }
            ];

            for (const { regex, embed } of patterns) {
                const match = url.match(regex);
                if (match) return embed(match[1]);
            }

            return null;
        }

        const hiddenInput = document.getElementById('content-html-input');

        if (hiddenInput.value) {
            quill.root.innerHTML = hiddenInput.value;
        }

                document.getElementById('update-form').addEventListener('submit', function () {
            hiddenInput.value = quill.root.innerHTML;
        });
    </script>
}
